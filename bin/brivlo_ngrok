#!/usr/bin/env ruby
# frozen_string_literal: true

require "uri"
require "brivlo/config"

Brivlo::Config.load

endpoint = Brivlo::Config.fetch("BRIVLO_ENDPOINT")

unless endpoint
  warn "Error: BRIVLO_ENDPOINT not set in ~/.brivlo.yml or environment"
  exit 1
end

uri = URI.parse(endpoint)
ngrok_url = uri.host
port = Brivlo::Config.fetch("PORT", "9292")

puts "Starting ngrok for Brivlo"
puts "  Tunnel: #{endpoint} -> localhost:#{port}"
puts

exec("ngrok", "http", "--url=#{ngrok_url}", port, *ARGV)
