<h2>Instances</h2>
<p>
  <% if show_all %>
    <a href="/board">Hide dismissed</a>
  <% else %>
    <a href="/board?all=1">Show all</a>
  <% end %>
</p>
<table>
  <thead>
    <tr>
      <th>Instance</th>
      <th>Host</th>
      <th>Status</th>
      <th>Event</th>
      <th>Card</th>
      <th>Tool</th>
      <th>Summary</th>
      <th>Last Seen</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% instances.each do |inst| %>
      <tr class="<%= inst[:status] %>">
        <td><a href="/board/<%= inst[:instance] %>"><%= inst[:instance] %></a></td>
        <td><%= inst[:host] %></td>
        <td><%= inst[:status] %></td>
        <td><%= inst[:event] %></td>
        <td><%= inst[:card] %></td>
        <td><%= inst[:tool] %></td>
        <td><%= inst[:summary] %></td>
        <td><%= relative_time(inst[:ts]) %></td>
        <td>
          <form method="post" action="/board/<%= inst[:instance] %>/dismiss">
            <button type="submit">Dismiss</button>
          </form>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<p><a href="/wait_reasons">Top Wait Reasons</a></p>
