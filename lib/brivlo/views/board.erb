<h2>Instances</h2>
<p>
  <% if show_all %>
    <a href="/board">Hide dismissed</a>
  <% else %>
    <a href="/board?all=1">Show all</a>
  <% end %>
</p>

<div class="board">
  <% instances.each do |inst| %>
    <div class="instance-card <%= inst[:status] %>">
      <div class="card-row primary">
        <span class="instance-name"><a href="/board/<%= inst[:instance] %>"><%= inst[:instance] %></a></span>
        <span class="status-event"><%= inst[:status] %> &middot; <%= inst[:event] %></span>
        <span class="last-seen"><%= relative_time(inst[:ts]) %></span>
        <form method="post" action="/board/<%= inst[:instance] %>/dismiss" class="inline-form">
          <button type="submit" class="btn-dismiss">Dismiss</button>
        </form>
      </div>
      <div class="card-row secondary">
        <span class="host"><%= inst[:host] %></span>
        <span class="details">
          <% if inst[:skill] %>Skill: <%= inst[:skill] %><% end %>
          <% if inst[:skill] && inst[:tool] %> &middot; <% end %>
          <% if inst[:tool] %>Tool: <%= truncate_tool(inst[:tool]) %><% end %>
          <% if (ds = display_summary(inst[:tool], inst[:summary])) %> &middot; <%= ds %><% end %>
        </span>
        <% if inst[:card_title] %>
          <form method="post" action="/board/<%= inst[:instance] %>/clear_card" class="inline-form clear-card-form">
            <button type="submit" title="Clear card" class="btn-clear">&times;</button>
          </form>
        <% end %>
      </div>
      <% if inst[:card_title] %>
        <div class="card-row card-info">
          <a href="<%= inst[:card_url] %>" target="_blank" class="card-link"><%= inst[:card_title] %></a>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

<p><a href="/wait_reasons">Top Wait Reasons</a></p>
